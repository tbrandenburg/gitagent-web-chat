{
  "name": "gitagent-web-chat-evals",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "eval": "PROMPTFOO_CONFIG_DIR=.promptfoo PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c evals/promptfooconfig.yaml --no-cache --max-concurrency 1",
    "eval:validate": "PROMPTFOO_CONFIG_DIR=.promptfoo PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo validate -c evals/promptfooconfig.yaml"
  },
  "devDependencies": { "promptfoo": "0.124.1" },
  "overrides": { "basic-ftp": "6.2.3" }
}
