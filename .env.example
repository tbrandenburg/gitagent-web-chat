# OPENAI_API_KEY is inherited from your shell. Uncomment to override it locally.
# OPENAI_API_KEY=replace-me
GITAGENT_AUTH=true
GITAGENT_USERNAME=admin
# Demo credentials only. Change this before any non-local use.
GITAGENT_PASSWORD=password
CHAT_PORT=3333

# OpenCode V2 uses the fixed username opencode; no supported no-auth mode.
OPENCODE_SERVER_PASSWORD=password
OPENCODE_PORT=4096
